ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
PAPER_TRADING_ONLY=true
DRY_RUN=true

MAX_PORTFOLIO_RISK=0.05
MAX_POSITION_RISK=0.01
MAX_DAILY_LOSS=0.02
MAX_OPEN_POSITIONS=8
MIN_DTE=21
MAX_DTE=45
MIN_OPEN_INTEREST=500
MAX_BID_ASK_SPREAD=0.15
MIN_CREDIT=0.25
MIN_VOLUME=50
MIN_AI_SCORE=75

# Bull Put Spread construction
SPREAD_WIDTH=5.0
TARGET_SHORT_DELTA_MIN=0.10
TARGET_SHORT_DELTA_MAX=0.30

# Deterministic scoring weights (must sum to 100)
SCORE_WEIGHT_REGIME=20
SCORE_WEIGHT_TREND=20
SCORE_WEIGHT_VOLATILITY=15
SCORE_WEIGHT_LIQUIDITY=15
SCORE_WEIGHT_STRIKE=15
SCORE_WEIGHT_REWARD=15

# AI Analyst — consultative only, never bypasses the Risk Engine.
# Set AI_PROVIDER=featherless with FEATHERLESS_API_KEY and an AI_MODEL id,
# e.g. Qwen/Qwen3-30B-A3B-Instruct-2507 — an "Instruct" non-thinking variant,
# so the response is plain JSON with no reasoning preamble to strip.
AI_PROVIDER=none
AI_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

PROFIT_TARGET_FRACTION=0.60
STOP_LOSS_FRACTION=0.50
EXIT_BEFORE_EXPIRY_DTE=7
REQUEST_TIMEOUT_SECONDS=15

ALPACA_DATA_FEED=iex
WATCHLIST=AAPL,MSFT,SPY,QQQ,NVDA

# Trade journal database. Empty = local SQLite file next to the scripts
# (default, used by tests and local dev). Set to a postgresql://... URL
# (e.g. a Supabase connection string) to share one journal across GitHub
# Actions, local development and a hosted dashboard instead of a separate
# SQLite file per environment. Add "options=-c search_path=<schema>" as a
# query parameter to use a dedicated Postgres schema instead of "public"
# (URL-encoded: "options=-c%20search_path%3D<schema>") — e.g.:
# postgresql://user:pass@host:6543/postgres?options=-c%20search_path%3Dalpaca
DATABASE_URL=

# Alpaca MCP Server (read-only query/demo path, see scripts/mcp_read_only_demo.py)
# Requires a separate install: `uv tool install alpaca-mcp-server`
MCP_SERVER_COMMAND=uvx
MCP_SERVER_ARGS=alpaca-mcp-server
